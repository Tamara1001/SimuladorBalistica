/* ═══════════════════════════════════════════════════════════════════════════
   SIMULADOR BALÍSTICO — Estilo Terminal HUD Militar "Nightglass"
   ═══════════════════════════════════════════════════════════════════════════ */

:root {
    --col-bg:         rgba(0, 15, 5, 0.7);
    --col-panel:      rgba(0, 25, 10, 0.85);
    --col-border:     #008f11;
    --col-border-dim: #004008;
    --col-accent:     #00ff41;
    --col-accent-dim: #00aa2b;
    --col-text:       #00ff41; 
    --col-text-dim:   #00aa2b;
    --col-fire:       #ff2a00;
    --col-warn:       #ffc107;
    
    --border-w:       1px;
}

/* ── HUD Root ────────────────────────────────────────────────────────────── */
.hud-root {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    /* Simulate terminal font by forcing uppercase styles where possible */
}

/* ── HUD Panels General ──────────────────────────────────────────────────── */
.hud-panel {
    position: absolute;
    background-color: var(--col-panel);
    border-color: var(--col-border);
    border-width: var(--border-w);
}

.panel-heading {
    background-color: rgba(0, 143, 17, 0.15);
    border-bottom-color: var(--col-border);
    border-bottom-width: var(--border-w);
    color: var(--col-text);
    font-size: 14px;
    -unity-font-style: bold;
    padding: 6px 12px;
    letter-spacing: 2px;
}

.panel-content {
    padding: 8px 12px;
}

/* ── Header ──────────────────────────────────────────────────────────────── */
.hud-header {
    position: absolute;
    top: 15px;
    left: 50%;
    translate: -50% 0;
    background-color: var(--col-panel);
    border-color: var(--col-border);
    border-width: var(--border-w);
    padding: 8px 30px;
    align-items: center;
    flex-direction: row;
}

.hud-title {
    font-size: 16px;
    color: var(--col-text);
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-right: 20px;
}

.hud-status {
    font-size: 12px;
    color: var(--col-text-dim);
    border-left-width: 1px;
    border-left-color: var(--col-border);
    padding-left: 20px;
}

/* ── Left Panel (Ammo) ───────────────────────────────────────────────────── */
.hud-left {
    top: 70px;
    left: 20px;
    width: 390px;
}

/* ── Right Panel (Targets) ───────────────────────────────────────────────── */
.hud-right {
    top: 70px;
    right: 20px;
    width: 360px;
    bottom: 120px;
}

/* ── Bottom Panel (Actions & Batch) ──────────────────────────────────────── */
.hud-bottom {
    bottom: 20px;
    left: 20px;
    right: 20px;
    height: 80px;
}

.hud-bottom-inner {
    flex-direction: row;
    height: 100%;
    justify-content: space-between;
    align-items: stretch;
}

.actions-group {
    flex-direction: row;
    align-items: center;
    padding: 0 20px;
    border-right-color: var(--col-border);
    border-right-width: var(--border-w);
    flex-grow: 1;
}

.batch-group {
    flex-direction: row;
    align-items: center;
    padding: 0 20px;
    justify-content: flex-end;
}

/* ── Field Rows (Inside panels) ──────────────────────────────────────────── */
.field-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 4px;
    margin-bottom: 2px;
}

.field-row:hover {
    background-color: rgba(0, 255, 65, 0.05);
}

.field-label {
    width: 115px;
    font-size: 11px;
    color: var(--col-text-dim);
    -unity-text-align: middle-left;
    letter-spacing: 1px;
}

/* ── Sliders ─────────────────────────────────────────────────────────────── */
.param-slider {
    flex-grow: 1;
    margin: 0 6px;
    height: 24px;
    align-self: center;
}

.param-slider .unity-base-slider__drag-container {
    position: relative;
    flex-grow: 1;
    height: 100%;
}

.param-slider .unity-base-slider__tracker {
    background-color: var(--col-border-dim);
    border-width: 0;
    height: 3px;
    border-radius: 0;
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    margin-top: -1px;
}

.param-slider .unity-base-slider__dragger {
    background-color: var(--col-text);
    border-width: 1px;
    border-color: #00ff41;
    width: 10px;
    height: 16px;
    border-radius: 0;
    position: absolute;
    top: 50%;
    margin-top: -8px;
}

.param-slider .unity-base-slider__dragger:hover {
    background-color: #ffffff;
}

/* ── Text Fields & Numerical Inputs (FloatField, IntegerField, TextField) ─ */
.param-field {
    width: 55px;
    margin: 0;
}

/* Selectores específicos de UI Toolkit para FloatField e IntegerField */
.param-field .unity-base-text-field__input,
.param-field .unity-float-field__input,
.param-field .unity-integer-field__input,
.param-field .unity-text-field__input,
.batch-field .unity-base-text-field__input,
.batch-field .unity-float-field__input,
.batch-field .unity-integer-field__input,
.batch-field .unity-text-field__input,
.unity-base-text-field__input,
.unity-float-field__input,
.unity-integer-field__input,
.unity-text-field__input {
    background-color: rgba(4, 20, 8, 0.95) !important;
    border-color: var(--col-border) !important;
    border-width: 1px !important;
    border-radius: 0 !important;
    color: var(--col-text) !important;
    font-size: 12px !important;
    padding: 2px 4px !important;
    -unity-text-align: middle-center !important;
    -unity-font-style: bold !important;
}

.param-field .unity-base-text-field__input:focus,
.param-field .unity-float-field__input:focus,
.param-field .unity-integer-field__input:focus,
.batch-field .unity-base-text-field__input:focus,
.unity-base-text-field__input:focus {
    background-color: rgba(0, 255, 65, 0.25) !important;
    border-color: var(--col-accent) !important;
}

/* ── Dropdown Specific (Control principal y Popup flotante) ──────────────── */
.dropdown {
    flex-grow: 1;
    margin: 0;
    height: 24px;
    max-width: 210px;
    overflow: hidden;
}

.dropdown .unity-base-popup-field__input {
    background-color: rgba(4, 20, 8, 0.95) !important;
    border-color: var(--col-border) !important;
    border-width: 1px !important;
    border-radius: 0 !important;
    padding: 2px 6px !important;
    overflow: hidden;
}

.dropdown .unity-base-popup-field__text {
    color: var(--col-text);
    font-size: 12px;
    -unity-font-style: bold;
    overflow: hidden;
}

.dropdown .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--col-text);
}

/* Estilo del Menú Desplegable (Popup Window) */
.unity-enum-field__menu,
.unity-base-dropdown__container,
.unity-type-popupmenu {
    background-color: rgba(2, 14, 6, 0.98);
    border-color: var(--col-border);
    border-width: 1px;
    border-radius: 0;
}

.unity-enum-field__item,
.unity-base-dropdown__item {
    color: var(--col-text-dim);
    font-size: 11px;
    padding: 4px 8px;
    border-bottom-color: rgba(0, 143, 17, 0.2);
    border-bottom-width: 1px;
}

.unity-enum-field__item:hover,
.unity-base-dropdown__item:hover,
.unity-base-dropdown__item--selected {
    background-color: rgba(0, 255, 65, 0.2);
    color: var(--col-text);
    -unity-font-style: bold;
}

/* ── Results ─────────────────────────────────────────────────────────────── */
.results-container {
    padding: 15px;
    background-color: rgba(0, 143, 17, 0.05);
    border-top-color: var(--col-border);
    border-top-width: 1px;
    border-bottom-color: var(--col-border);
    border-bottom-width: 1px;
    margin: 5px 10px;
}

.result-label {
    font-size: 14px;
    color: var(--col-text);
    -unity-font-style: bold;
    margin-bottom: 5px;
    letter-spacing: 1px;
}

/* ── Batch Testing ───────────────────────────────────────────────────────── */
.batch-title {
    font-size: 13px;
    color: var(--col-warn);
    -unity-font-style: bold;
    margin-right: 15px;
    letter-spacing: 2px;
}

.batch-fields-container {
    flex-direction: row;
    margin-right: 15px;
}

.batch-field-group {
    flex-direction: row;
    align-items: center;
    margin-right: 10px;
    border-color: var(--col-border-dim);
    border-width: 1px;
    padding: 4px 8px;
    background-color: rgba(0, 20, 0, 0.5);
}

.batch-field-group > Label {
    font-size: 10px;
    color: var(--col-text-dim);
    margin-right: 8px;
    -unity-font-style: bold;
}

.batch-sub-label {
    font-size: 9px;
    color: var(--col-text-dim);
    margin-left: 4px;
    margin-right: 2px;
}

.batch-field {
    width: 40px;
    margin: 0;
}

.batch-field > .unity-text-field__input {
    color: var(--col-warn);
    border-color: var(--col-border-dim);
    padding: 2px;
    font-size: 10px;
}

.batch-field > Label {
    display: none;
}

.batch-status-label {
    color: var(--col-text-dim);
    font-size: 10px;
    margin-right: 15px;
    -unity-text-align: middle-right;
    width: 80px;
}

/* ── Buttons ─────────────────────────────────────────────────────────────── */
.btn-fire {
    background-color: transparent;
    border-color: var(--col-fire);
    border-width: 1px;
    color: var(--col-fire);
    font-size: 16px;
    -unity-font-style: bold;
    padding: 10px 25px;
    margin-right: 15px;
    letter-spacing: 3px;
    border-radius: 0;
}

.btn-fire:hover {
    background-color: rgba(255, 42, 0, 0.15);
    border-color: #ff6b4a;
    color: #ff6b4a;
}

.btn-fire:active {
    background-color: var(--col-fire);
    color: black;
}

.btn-fire:disabled {
    border-color: #551000;
    color: #551000;
}

.btn-secondary {
    background-color: transparent;
    border-color: var(--col-border);
    border-width: 1px;
    color: var(--col-text);
    font-size: 12px;
    padding: 8px 15px;
    margin-right: 10px;
    letter-spacing: 1px;
    border-radius: 0;
}

.btn-secondary:hover {
    background-color: rgba(0, 255, 65, 0.15);
}

.btn-secondary:active {
    background-color: var(--col-text);
    color: black;
}

.btn-batch {
    background-color: transparent;
    border-color: var(--col-warn);
    border-width: 1px;
    color: var(--col-warn);
    font-size: 12px;
    padding: 8px 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    border-radius: 0;
}

.btn-batch:hover {
    background-color: rgba(255, 193, 7, 0.15);
}

.btn-batch:active {
    background-color: var(--col-warn);
    color: black;
}

/* ── Cloud Persistence Buttons ───────────────────────────────────────────── */
.btn-cloud {
    background-color: transparent;
    border-color: #00aaff;
    border-width: 1px;
    color: #00aaff;
    font-size: 11px;
    -unity-font-style: bold;
    padding: 6px 10px;
    letter-spacing: 1px;
    border-radius: 0;
    flex-grow: 1;
    margin-right: 6px;
}

.btn-cloud:hover {
    background-color: rgba(0, 170, 255, 0.15);
    border-color: #44ccff;
    color: #44ccff;
}

.btn-cloud:active {
    background-color: #00aaff;
    color: black;
}

.btn-cloud:disabled {
    border-color: #004466;
    color: #004466;
}

.cloud-status-label {
    font-size: 10px;
    color: #007799;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 2px 0;
}

/* ── Picture-in-Picture Camera Panel ────────────────────────────────────── */
.pip-panel {
    position: absolute;
    bottom: 105px;
    left: 20px;
    width: 390px;
    height: 320px;
    border-color: var(--col-accent);
    border-width: 1px;
    background-color: rgba(0, 8, 3, 0.92);
    overflow: hidden;
}

.pip-header {
    background-color: rgba(0, 255, 65, 0.12);
    border-bottom-color: var(--col-accent);
    border-bottom-width: 1px;
    color: var(--col-accent);
    font-size: 10px;
    -unity-font-style: bold;
    padding: 4px 8px;
    letter-spacing: 2px;
}

/* Contenedor de la imagen con efecto scanlines (gradiente de bandas) */
.pip-scanlines {
    flex-grow: 1;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 1);
}

.pip-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: stretch-to-fill;
}

.pip-info-label {
    color: var(--col-text-dim);
    font-size: 9px;
    -unity-font-style: bold;
    padding: 3px 8px;
    letter-spacing: 1px;
    border-top-color: rgba(0, 143, 17, 0.3);
    border-top-width: 1px;
    -unity-text-align: middle-left;
}
