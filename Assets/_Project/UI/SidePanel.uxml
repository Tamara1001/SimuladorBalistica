<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="Styles/MilitaryDark.uss"/>
    <ui:VisualElement name="hud-root" class="hud-root">

        <!-- HEADER (TOP CENTER) -->
        <ui:VisualElement class="hud-header">
            <ui:Label text="SIMULADOR BALÍSTICO" class="hud-title"/>
            <ui:Label name="lbl-status" text="EN ESPERA" class="hud-status"/>
        </ui:VisualElement>

        <!-- LEFT PANEL (MUNICIÓN) -->
        <ui:VisualElement class="hud-panel hud-left">
            <ui:Label text="> MÓDULO: MUNICIÓN" class="panel-heading"/>
            <ui:VisualElement class="panel-content">
                <ui:VisualElement class="field-row">
                    <ui:Label text="PREAJUSTE" class="field-label"/>
                    <ui:DropdownField name="preset-dropdown" class="dropdown"/>
                </ui:VisualElement>
                
                <ui:VisualElement class="field-row" style="margin-top: 10px;">
                    <ui:Label text="ÁNGULO (°)" class="field-label"/>
                    <ui:Slider name="angle-slider" low-value="0" high-value="90" value="10" class="param-slider"/>
                    <ui:FloatField name="angle-field" value="10" class="param-field"/>
                </ui:VisualElement>

                <ui:VisualElement class="field-row">
                    <ui:Label text="VELOCIDAD (m/s)" class="field-label"/>
                    <ui:Slider name="velocity-slider" low-value="10" high-value="500" value="45" class="param-slider"/>
                    <ui:FloatField name="velocity-field" value="45" class="param-field"/>
                </ui:VisualElement>

                <ui:VisualElement class="field-row">
                    <ui:Label text="MASA (g)" class="field-label"/>
                    <ui:Slider name="mass-slider" low-value="0.5" high-value="100" value="8" class="param-slider"/>
                    <ui:FloatField name="mass-field" value="8" class="param-field"/>
                </ui:VisualElement>

                <ui:VisualElement class="field-row">
                    <ui:Label text="RADIO (mm)" class="field-label"/>
                    <ui:Slider name="radius-slider" low-value="1" high-value="30" value="4.5" class="param-slider"/>
                    <ui:FloatField name="radius-field" value="4.5" class="param-field"/>
                </ui:VisualElement>

                <ui:VisualElement class="field-row" style="margin-top: 15px; border-top-width: 1px; border-color: rgba(0, 143, 17, 0.3); padding-top: 10px;">
                    <ui:Label text="GRAVEDAD (m/s²)" class="field-label"/>
                    <ui:Slider name="gravity-slider" low-value="1" high-value="25" value="9.81" class="param-slider"/>
                    <ui:FloatField name="gravity-field" value="9.81" class="param-field"/>
                </ui:VisualElement>

                <ui:VisualElement class="field-row">
                    <ui:Label text="VEL. SIM (x)" class="field-label"/>
                    <ui:Slider name="timescale-slider" low-value="0.1" high-value="3.0" value="1.0" class="param-slider"/>
                    <ui:FloatField name="timescale-field" value="1.0" class="param-field"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- RIGHT PANEL (OBJETOS Y RESULTADOS) -->
        <ui:VisualElement class="hud-panel hud-right">
            <ui:Label text="> MÓDULO: OBJETIVOS" class="panel-heading"/>
            <ui:VisualElement class="panel-content">
                <ui:VisualElement class="field-row">
                    <ui:Label text="FILAS" class="field-label"/>
                    <ui:SliderInt name="rows-slider" low-value="0" high-value="5" value="2" class="param-slider"/>
                    <ui:IntegerField name="rows-field" value="2" class="param-field"/>
                </ui:VisualElement>

                <ui:VisualElement class="field-row">
                    <ui:Label text="COLUMNAS" class="field-label"/>
                    <ui:SliderInt name="cols-slider" low-value="0" high-value="5" value="3" class="param-slider"/>
                    <ui:IntegerField name="cols-field" value="3" class="param-field"/>
                </ui:VisualElement>

                <ui:VisualElement class="field-row">
                    <ui:Label text="PROFUNDIDAD" class="field-label"/>
                    <ui:SliderInt name="depth-slider" low-value="1" high-value="5" value="2" class="param-slider"/>
                    <ui:IntegerField name="depth-field" value="2" class="param-field"/>
                </ui:VisualElement>

                <ui:VisualElement class="field-row" style="margin-top: 10px; border-top-width: 1px; border-color: rgba(0, 143, 17, 0.3); padding-top: 10px;">
                    <ui:Label text="TAMAÑO (m)" class="field-label"/>
                    <ui:Slider name="boxsize-slider" low-value="0.1" high-value="3" value="1" class="param-slider"/>
                    <ui:FloatField name="boxsize-field" value="1" class="param-field"/>
                </ui:VisualElement>

                <ui:VisualElement class="field-row">
                    <ui:Label text="MASA (kg)" class="field-label"/>
                    <ui:Slider name="boxmass-slider" low-value="0.5" high-value="500" value="20" class="param-slider"/>
                    <ui:FloatField name="boxmass-field" value="20" class="param-field"/>
                </ui:VisualElement>

                <ui:VisualElement class="field-row">
                    <ui:Label text="DISTANCIA (m)" class="field-label"/>
                    <ui:Slider name="boxdist-slider" low-value="5" high-value="150" value="35" class="param-slider"/>
                    <ui:FloatField name="boxdist-field" value="35" class="param-field"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Label text="> DATOS: ÚLTIMO DISPARO" class="panel-heading" style="margin-top: 5px;"/>
            <ui:VisualElement class="panel-content results-container">
                <ui:Label name="lbl-range"      text="RANGO: —" class="result-label"/>
                <ui:Label name="lbl-maxheight"  text="ALT. MÁX: —" class="result-label"/>
                <ui:Label name="lbl-flighttime" text="T. VUELO: —" class="result-label"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- BOTTOM PANEL (ACCIONES Y PRUEBAS EN LOTE) -->
        <ui:VisualElement class="hud-panel hud-bottom">
            <ui:VisualElement class="hud-bottom-inner">
                
                <ui:VisualElement class="actions-group">
                    <ui:Button name="btn-fire"   text="[ DISPARAR ]"   class="btn-fire"/>
                    <ui:Button name="btn-pause"  text="PAUSAR"         class="btn-secondary"/>
                    <ui:Button name="btn-step"   text="PASO"           class="btn-secondary"/>
                    <ui:Button name="btn-reset"  text="REINICIAR"      class="btn-secondary"/>
                    <ui:Button name="btn-export" text="EXPORTAR LOG"   class="btn-secondary"/>
                </ui:VisualElement>

                <ui:VisualElement class="batch-group">
                    <ui:Label text="PRUEBA EN LOTE //" class="batch-title"/>
                    
                    <ui:VisualElement class="batch-fields-container">
                        <ui:VisualElement class="batch-field-group">
                            <ui:Label text="ÁNGULO"/>
                            <ui:Label text="Mín" class="batch-sub-label"/>
                            <ui:FloatField name="batch-angle-min" value="10" class="batch-field"/>
                            <ui:Label text="Máx" class="batch-sub-label"/>
                            <ui:FloatField name="batch-angle-max" value="80" class="batch-field"/>
                            <ui:Label text="Paso" class="batch-sub-label"/>
                            <ui:FloatField name="batch-angle-step" value="10" class="batch-field"/>
                        </ui:VisualElement>

                        <ui:VisualElement class="batch-field-group">
                            <ui:Label text="VELOCIDAD"/>
                            <ui:Label text="Mín" class="batch-sub-label"/>
                            <ui:FloatField name="batch-vel-min" value="100" class="batch-field"/>
                            <ui:Label text="Máx" class="batch-sub-label"/>
                            <ui:FloatField name="batch-vel-max" value="100" class="batch-field"/>
                            <ui:Label text="Paso" class="batch-sub-label"/>
                            <ui:FloatField name="batch-vel-step" value="1" class="batch-field"/>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: flex-end;">
                        <ui:Label name="lbl-batch-status" text="" class="batch-status-label"/>
                        <ui:Button name="btn-batch-run" text="EJECUTAR LOTE" class="btn-batch"/>
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
